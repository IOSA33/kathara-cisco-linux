enable
configure terminal

hostname Reititin0

interface GigabitEthernet0/0
 ip address 192.168.0.10 255.255.255.252
 no shutdown
 exit

interface GigabitEthernet0/1
 ip address 192.168.0.2 255.255.255.252
 no shutdown
 exit

interface GigabitEthernet0/2
 ip address 192.168.0.5 255.255.255.252
 no shutdown
 exit

router rip
 version 2
 no auto-summary
 network 192.168.0.0

end
write memory